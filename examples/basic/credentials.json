{
  "$schema": "../../schema/registry.schema.json",
  "formatVersion": "1",
  "credentials": [
    {
      "id": "example-app/prod/SESSION_KEY",
      "name": "SESSION_KEY",
      "description": "Encrypts example-app's stored sessions.",
      "system": "example-app",
      "environment": "prod",
      "kind": "random-secret",
      "status": "active",
      "sensitivity": "high",
      "owner": "platform team",
      "issuer": {
        "type": "self"
      },
      "generation": {
        "method": "random",
        "spec": "32 random bytes, hex",
        "where": "the operator's machine, straight into the parameter store",
        "command": "openssl rand -hex 32"
      },
      "entitlements": [
        {
          "resource": "example-app sessions",
          "access": "decrypt and forge"
        }
      ],
      "stores": [
        {
          "type": "aws-ssm",
          "role": "primary",
          "account": "hosting",
          "path": "/example/prod/SESSION_KEY"
        },
        {
          "type": "host-file",
          "role": "rendered",
          "path": "/etc/example-app/env",
          "note": "written at each deploy"
        }
      ],
      "consumers": [
        {
          "system": "example-app",
          "component": "api",
          "via": "env SESSION_KEY"
        }
      ],
      "rotation": {
        "policy": "scheduled",
        "intervalDays": 180,
        "procedure": "Add the new key with a new key ID, deploy, then remove the old key after the session lifetime.",
        "impact": "None when the old key stays until sessions expire."
      },
      "handling": {
        "generate": "human",
        "distribute": "system",
        "rotate": "human",
        "automation": "the deploy tool renders it onto the server"
      },
      "revocation": "Remove the key and deploy: every session ends.",
      "exposure": "Read and forge any stored session.",
      "tags": [
        "runtime"
      ]
    },
    {
      "id": "example-app/prod/DB_PASSWORD",
      "name": "DB_PASSWORD",
      "description": "The application role's database password.",
      "system": "example-app",
      "environment": "prod",
      "kind": "password",
      "status": "active",
      "sensitivity": "critical",
      "owner": "platform team",
      "issuer": {
        "type": "postgres",
        "account": "example-db"
      },
      "generation": {
        "method": "random",
        "spec": "32 random bytes, hex",
        "command": "openssl rand -hex 32"
      },
      "entitlements": [
        {
          "resource": "database example_app",
          "access": "read and write rows; no DDL"
        }
      ],
      "stores": [
        {
          "type": "aws-ssm",
          "role": "primary",
          "path": "/example/prod/migrate/DB_PASSWORD"
        }
      ],
      "consumers": [
        {
          "system": "example-app",
          "component": "migrate",
          "via": "env DB_PASSWORD"
        }
      ],
      "rotation": {
        "policy": "scheduled",
        "intervalDays": 365,
        "procedure": "ALTER ROLE with the new password, update the parameter and the DSN, deploy."
      },
      "handling": {
        "generate": "human",
        "distribute": "system",
        "rotate": "human",
        "automation": "the deploy tool passes it to migrate"
      },
      "revocation": "ALTER ROLE example_app NOLOGIN.",
      "exposure": "Every row of the application's database."
    },
    {
      "id": "example-app/prod/DB_DSN",
      "name": "DB_DSN",
      "description": "The connection string the service uses.",
      "system": "example-app",
      "environment": "prod",
      "kind": "connection-string",
      "status": "active",
      "sensitivity": "critical",
      "owner": "platform team",
      "issuer": {
        "type": "postgres",
        "account": "example-db"
      },
      "generation": {
        "method": "derived",
        "spec": "postgres://example_app:<password>@<host>:5432/example_app?sslmode=require"
      },
      "stores": [
        {
          "type": "aws-ssm",
          "role": "primary",
          "path": "/example/prod/DB_DSN"
        }
      ],
      "consumers": [
        {
          "system": "example-app",
          "component": "api",
          "via": "env DB_DSN"
        }
      ],
      "rotation": {
        "policy": "on-demand",
        "procedure": "Rebuilt whenever DB_PASSWORD rotates."
      },
      "handling": {
        "generate": "human",
        "distribute": "system",
        "rotate": "human",
        "automation": "the deploy tool renders it onto the server"
      },
      "dependsOn": [
        "example-app/prod/DB_PASSWORD"
      ]
    },
    {
      "id": "example-app/ci/MODULES_TOKEN",
      "name": "MODULES_TOKEN",
      "description": "Lets CI fetch the private Go modules the build needs.",
      "system": "example-app",
      "kind": "personal-access-token",
      "status": "active",
      "sensitivity": "medium",
      "owner": "repository admin",
      "issuer": {
        "type": "github",
        "account": "example-org",
        "console": "https://github.com/settings/personal-access-tokens"
      },
      "generation": {
        "method": "issued",
        "where": "GitHub, Settings, Developer settings, Fine-grained personal access tokens",
        "steps": [
          "Resource owner: the organization.",
          "Repository access: only the private module repositories.",
          "Permissions: Contents read-only.",
          "Copy the token straight into the repository secret."
        ]
      },
      "entitlements": [
        {
          "resource": "github.com/example-org/private-module",
          "access": "contents: read"
        }
      ],
      "stores": [
        {
          "type": "github-actions",
          "role": "primary",
          "account": "example-org/example-app",
          "path": "MODULES_TOKEN"
        }
      ],
      "consumers": [
        {
          "system": "example-app",
          "component": "CI test and lint jobs",
          "via": "git insteadOf URL"
        }
      ],
      "rotation": {
        "policy": "on-expiry",
        "procedure": "Regenerate the token in GitHub and update the secret.",
        "impact": "CI fails at the module fetch until it is replaced."
      },
      "handling": {
        "generate": "human",
        "distribute": "human",
        "rotate": "human"
      },
      "revocation": "Delete the token in GitHub.",
      "exposure": "Read the private module's source.",
      "tags": [
        "ci"
      ],
      "links": [
        {
          "title": "Fine-grained tokens",
          "url": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens"
        }
      ]
    },
    {
      "id": "example-app/ci/aws-deploy-role",
      "name": "deploy role (OIDC)",
      "description": "CI assumes this role with GitHub's OIDC token: no stored key.",
      "system": "example-app",
      "kind": "federated",
      "status": "planned",
      "sensitivity": "high",
      "owner": "platform team",
      "issuer": {
        "type": "aws",
        "account": "hosting"
      },
      "generation": {
        "method": "federated",
        "where": "an IAM role trusting token.actions.githubusercontent.com"
      },
      "entitlements": [
        {
          "resource": "the deploy bucket",
          "access": "PutObject"
        }
      ],
      "consumers": [
        {
          "system": "example-app",
          "component": "release workflow"
        }
      ],
      "rotation": {
        "policy": "on-demand"
      },
      "handling": {
        "generate": "system",
        "distribute": "system",
        "rotate": "system",
        "automation": "GitHub OIDC and AWS STS issue a short-lived token per run"
      },
      "tags": [
        "ci"
      ]
    }
  ]
}
